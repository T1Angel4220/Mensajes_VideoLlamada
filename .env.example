# ==============================================================================
# Variables de Entorno - Plantilla de Configuración (.env.example)
# ==============================================================================
# Copie este archivo como '.env' para definir sus valores locales.
# NUNCA suba el archivo '.env' con secretos reales al repositorio.

# Clave secreta para la firma criptográfica de sesiones de Flask.
# En producción, genere una clave segura (ejemplo: python -c "import secrets; print(secrets.token_hex(32))")
APP_SESSION_SIGNING_KEY=tu_clave_secreta_hex_32_bytes_aqui

# Permite HTTP plano en entorno de desarrollo local (1 = habilitar HTTP, 0 = exigir HTTPS estricto)
APP_ALLOW_HTTP=1

# Configuración de SonarQube (para escaneos locales de calidad de código)
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=tu_token_de_sonarqube_aqui
